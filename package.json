{
  "name": "group-explorer",
  "version": "test-3.7rc30",
  "description": "Group theory visualization application for the web",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "mocha 'tests/*_Tests*.js'",
    "test:watch": "mocha --watch 'tests/*_Tests*.js'",
    "coverage": "c8 mocha 'tests/*_Tests*.js'",
    "coverage:one": "c8 --no-all mocha",
    "type-coverage": "type-coverage"
  },
  "typeCoverage": {
    "atLeast": 100,
    "ignoreFiles": ["**/*.d.ts"],
    "cache": true
  },
  "keywords": [
    "mathematics",
    "visualization",
    "algebra",
    "groups"
  ],
  "author": "Ray Ellis and Nathan Carter",
  "license": "LGPL-3.0",
  "devDependencies": {
    "@types/three": "^0.170.0",
    "c8": "^12.0.0",
    "chai": "^4.3.8",
    "fake-indexeddb": "^6.2.5",
    "linkedom": "^0.18.13",
    "mocha": "^10.2.0",
    "three": "^0.170.0",
    "type-coverage": "^2.30.1",
    "typescript": "^6.0.3"
  }
}
